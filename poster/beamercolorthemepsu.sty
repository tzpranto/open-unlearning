% LaTeX beamer color theme, Penn State brand palette (solid colors only, no gradients).
%
\mode<presentation>

% Primary
\definecolor{psu-beaver}   {HTML}{1E407C} % Beaver Blue
\definecolor{psu-navy}     {HTML}{001E44} % Nittany Navy
\definecolor{psu-pugh}     {HTML}{96BEE6} % Pugh Blue
\definecolor{psu-white}    {HTML}{FFFFFF}
\definecolor{psu-black}    {HTML}{000000}

% Accent, used sparingly to highlight results
\definecolor{psu-pink}     {HTML}{BC204B} % Original 87 Pink

% Solid tints for box backgrounds
\colorlet{psu-beaver-tint}{psu-beaver!7}
\colorlet{psu-pugh-tint}  {psu-pugh!22}

\mode<all>
